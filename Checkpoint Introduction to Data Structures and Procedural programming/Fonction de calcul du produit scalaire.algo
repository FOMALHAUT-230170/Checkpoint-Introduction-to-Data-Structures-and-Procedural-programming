// Fonction de calcul du produit scalaire
FUNCTION dot_product(v1, v2 : ARRAY_OF REAL[3]) : REAL
VAR
    i : INTEGER;
    ps : REAL := 0.0;
BEGIN
    FOR i FROM 0 TO 2 DO
        ps := ps + (v1[i] * v2[i]);
    END_FOR
    RETURN ps;
END

// Algorithme principal modifié
ALGORITHM vecteurs_orthogonaux_fonction
VAR
    v1, v2 : ARRAY_OF REAL[3];
    n, k, i : INTEGER;
BEGIN
    Write("Entrez le nombre de couples de vecteurs (n) : ");
    Read(n);

    FOR k FROM 1 TO n DO
        Write("--- Couple de vecteurs N° ", k, " ---");
        
        FOR i FROM 0 TO 2 DO
            Write("v1[", i, "] = "); Read(v1[i]);
        END_FOR
        
        FOR i FROM 0 TO 2 DO
            Write("v2[", i, "] = "); Read(v2[i]);
        END_FOR

        // Appel direct de la fonction dans la condition IF
        IF (dot_product(v1, v2) = 0.0) THEN
            Write("Les vecteurs sont orthogonaux.");
        ELSE
            Write("Les vecteurs ne sont pas orthogonaux.");
        END_IF
    END_FOR
END
